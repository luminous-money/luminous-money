{
  "name": "@fava-beans/monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hostable, database-driven double-entry accounting with Beancount as the engine.",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "docker buildx bake",
    "test": "docker buildx bake test",
    "test:unit": "pnpm -r --filter \"./packages/**\" --filter \"./services/**\" test",
    "e2e": "./scripts/e2e.sh",
    "test:cli": "./scripts/cli-test.sh",
    "e2e:local": "pnpm --filter \"./tests/**...\" build && pnpm --filter @fava-beans/e2e test && ./scripts/ui-local.sh",
    "seed": "./scripts/seed-demo.sh",
    "generate": "docker buildx bake generate && pnpm -r generate",
    "release": "docker buildx bake release",
    "up": "docker buildx bake && docker compose up",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"{packages,services,tests}/*/src/**/*.{ts,tsx,css}\"",
    "prettier": "prettier --check \"{packages,services,tests}/*/src/**/*.{ts,tsx,css}\""
  },
  "prettier": {
    "printWidth": 100,
    "trailingComma": "es5"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
