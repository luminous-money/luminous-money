#!/usr/bin/env bash
# luminous-money: install and run a Luminous Money server. Needs Docker (with Compose v2) and curl.
# See docs/deploying.md, or `luminous-money help`.
#
# A deployment is one directory (default ~/luminous-money) holding compose.yaml (from a release),
# .env (its settings and secrets), this script, and backups/. Every command acts on the
# deployment it's run from: the directory it lives in, else $LUMINOUS_MONEY_HOME, else the current
# directory.
#
# Portable on purpose: bash 3.2 (macOS's), no GNU-only flags.
set -euo pipefail

REPO="${LUMINOUS_MONEY_REPO:-luminous-money/luminous-money}"
REGISTRY_DEFAULT="ghcr.io/luminous-money/luminous-money"
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

say() { printf '%s\n' "$*"; }
warn() { printf '%s\n' "$*" >&2; }
die() {
  warn "luminous-money: $*"
  exit 1
}

usage() {
  cat <<'EOF'
luminous-money: install and run a Luminous Money server.

  luminous-money install [options]   set up a new deployment (asks what it needs)
      --dir DIR                  where (default ~/luminous-money)
      --domain DOMAIN            a public server: HTTPS for DOMAIN, with a Let's Encrypt
      --email EMAIL                certificate (ports 80 and 443 must reach this machine)
      --port PORT                otherwise plain HTTP on PORT (default 8080)
      --bind ADDRESS             listen only on ADDRESS (127.0.0.1: this machine only)
      --version VERSION          a release (default: the latest)
      --name NAME                the Compose project (default: the directory's name)
      --from DIR                 take compose.yaml from DIR (a clone or a bundle), not a release
      --registry REGISTRY        where the images are (default the release's; `luminous-money`
                                   for images built here with `pnpm build`)
      --yes                      ask nothing: take the defaults and the options given

  luminous-money status              each service's state, health and version; the latest release
  luminous-money up | down           start (and wait until healthy) | stop (the data stays)
  luminous-money upgrade [VERSION]   back up, then move to VERSION (default: the latest release)
      --from DIR                 take compose.yaml from DIR instead of the release
  luminous-money backup [--keep N]   a whole-system backup into backups/ (keeping the newest N)
  luminous-money restore FILE        stop, replace everything with FILE's, start
      --version VERSION          and run VERSION (the one the backup was made with, say)
      --yes                      don't ask first
  luminous-money logs [SERVICE...]   the logs, timestamped (--since 2h, --follow)
  luminous-money report [--since 24h]
                                 a bundle for a bug report: logs, status, versions, and the
                                   settings with every secret removed
  luminous-money config              check .env, and show it with its secrets hidden
EOF
}

# --- where the deployment is ----------------------------------------------------------------

deployment() {
  local here
  here="$(dirname "$SELF")"
  if [ -f "$here/compose.yaml" ] && [ -f "$here/.env" ]; then
    echo "$here"
  elif [ -n "${LUMINOUS_MONEY_HOME:-}" ]; then
    echo "$LUMINOUS_MONEY_HOME"
  elif [ -f ./compose.yaml ]; then
    pwd
  else
    die "no deployment here: run this from one (or set LUMINOUS_MONEY_HOME), or \`luminous-money install\`"
  fi
}

HOME_DIR=""
compose() {
  docker compose --project-directory "$HOME_DIR" -f "$HOME_DIR/compose.yaml" "$@"
}

# A setting from .env (empty if unset).
setting() {
  [ -f "$HOME_DIR/.env" ] || return 0
  awk -F= -v key="$1" '$1 == key { sub(/^[^=]*=/, ""); value = $0 } END { print value }' "$HOME_DIR/.env"
}

# Set (or add) a setting in .env, keeping everything else as it is.
set_setting() {
  local file="$HOME_DIR/.env" tmp
  tmp="$(mktemp "$HOME_DIR/.env.XXXXXX")"
  awk -F= -v key="$1" -v value="$2" '
    $1 == key { print key "=" value; done = 1; next }
    { print }
    END { if (!done) print key "=" value }
  ' "$file" >"$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$file"
}

# --- small helpers --------------------------------------------------------------------------

need() {
  command -v docker >/dev/null || die "Docker isn't installed: https://docs.docker.com/get-docker/"
  docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is needed (\`docker compose\`)"
  docker info >/dev/null 2>&1 || die "Docker isn't running (or this user can't use it)"
}

# 32 random bytes, base64: an encryption key.
key() {
  if command -v openssl >/dev/null; then
    openssl rand -base64 32
  else
    head -c 32 /dev/urandom | base64 | tr -d '\n'
    echo
  fi
}

# The latest release's version (without the v), or nothing if it can't be found.
latest() {
  { curl -fsSL --max-time 10 "https://api.github.com/repos/$REPO/releases/latest" 2>/dev/null |
    awk -F'"' '/"tag_name"/ { sub(/^v/, "", $4); print $4; exit }'; } || true
}

# A file from a release (or from --from's directory).
fetch() { # fetch NAME VERSION FROM DEST
  local name="$1" version="$2" from="$3" dest="$4"
  if [ -n "$from" ]; then
    [ -f "$from/$name" ] || die "$from has no $name"
    cp "$from/$name" "$dest"
  else
    curl -fsSL "https://github.com/$REPO/releases/download/v$version/$name" -o "$dest" ||
      die "couldn't download $name for version $version (is it a release?)"
  fi
}

ask() { # ask PROMPT DEFAULT -> the answer
  local answer
  if [ "${YES:-}" = 1 ] || [ ! -t 0 ]; then
    echo "$2"
    return
  fi
  read -r -p "$1 [$2]: " answer
  echo "${answer:-$2}"
}

stamp() { date -u +%Y%m%dT%H%M%SZ; }

# --- install --------------------------------------------------------------------------------

cmd_install() {
  local dir="$HOME/luminous-money" domain="" email="" port="" bind="" version="" name="" from=""
  local registry=""
  YES=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dir) dir="$2"; shift 2 ;;
      --domain) domain="$2"; shift 2 ;;
      --email) email="$2"; shift 2 ;;
      --port) port="$2"; shift 2 ;;
      --bind) bind="$2"; shift 2 ;;
      --version) version="$2"; shift 2 ;;
      --name) name="$2"; shift 2 ;;
      --from) from="$(cd "$2" && pwd)"; shift 2 ;;
      --registry) registry="$2"; shift 2 ;;
      --yes) YES=1; shift ;;
      *) die "install: unknown option $1" ;;
    esac
  done
  need
  if [ -z "$from" ]; then command -v curl >/dev/null || die "curl is needed, to download the release"; fi
  mkdir -p "$dir"
  HOME_DIR="$(cd "$dir" && pwd)"
  if [ -f "$HOME_DIR/.env" ]; then
    die "$HOME_DIR already has a deployment: use \`luminous-money upgrade\`"
  fi

  if [ -z "$version" ]; then
    if [ -n "$from" ]; then
      version=dev
    else
      version="$(latest)"
      [ -n "$version" ] || die "couldn't find the latest release of $REPO: give --version"
    fi
  fi
  [ -n "$registry" ] || registry="$([ -n "$from" ] && [ "$version" = dev ] && echo luminous-money || echo "$REGISTRY_DEFAULT")"
  [ -n "$name" ] || name="$(basename "$HOME_DIR" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9_\n-' '-')"

  if [ -z "$domain" ] && [ -z "$port" ]; then
    say "Where will people reach it?"
    say "  1) This computer, or my own network (http://this-machine:PORT)"
    say "  2) A public server with a domain name (HTTPS, with a free Let's Encrypt certificate)"
    case "$(ask "Choose" 1)" in
      2)
        domain="$(ask "The domain (its DNS pointing here), e.g. books.example.com" "")"
        [ -n "$domain" ] || die "a public server needs a domain"
        ;;
      *) port="$(ask "The port" 8080)" ;;
    esac
  fi
  if [ -n "$domain" ] && [ -z "$email" ]; then
    email="$(ask "An email for Let's Encrypt (about the certificate)" "")"
    [ -n "$email" ] || die "HTTPS needs an email for Let's Encrypt: --email"
  fi

  say "Installing Luminous Money $version in $HOME_DIR (project $name)…"
  fetch compose.yaml "$version" "$from" "$HOME_DIR/compose.yaml"
  umask 077
  {
    echo "# Luminous Money's settings (docs/deploying.md). Keep this file: its keys open what's stored."
    echo "COMPOSE_PROJECT_NAME=$name"
    echo "LUMINOUS_MONEY_REGISTRY=$registry"
    echo "LUMINOUS_MONEY_VERSION=$version"
    if [ -n "$domain" ]; then
      echo "LUMINOUS_MONEY_DOMAIN=$domain"
      echo "LUMINOUS_MONEY_ACME_EMAIL=$email"
      echo "LUMINOUS_MONEY_PUBLIC_URL=https://$domain"
      echo "LUMINOUS_MONEY_PORT=80"
      echo "LUMINOUS_MONEY_HTTPS_PORT=443"
    else
      echo "LUMINOUS_MONEY_PORT=${port:-8080}"
    fi
    if [ -n "$bind" ]; then echo "LUMINOUS_MONEY_BIND=$bind"; fi
    echo "# Encryption keys for stored bank-feed and AI credentials: back them up."
    echo "SIMPLEFIN_ENCRYPTION_KEY=$(key)"
    echo "AI_ENCRYPTION_KEY=$(key)"
    echo "# Email, for password resets (optional), e.g. smtps://user:pass@smtp.example.com"
    echo "# SMTP_URL="
    echo "# MAIL_FROM=Luminous Money <books@example.com>"
  } >"$HOME_DIR/.env"
  umask 022
  cp "$SELF" "$HOME_DIR/luminous-money"
  chmod +x "$HOME_DIR/luminous-money"
  mkdir -p "$HOME_DIR/backups"

  if [ "$registry" != luminous-money ]; then
    compose pull --quiet
  fi
  compose up -d --wait --wait-timeout 180
  say ""
  if [ -n "$domain" ]; then
    say "Luminous Money is running: https://$domain/ (the certificate can take a minute)."
  else
    say "Luminous Money is running: http://localhost:${port:-8080}/ (and this machine's address, on your network)."
  fi
  say "Create your account there: the first one is no different from the rest."
  say "From now on: $HOME_DIR/luminous-money status | backup | upgrade | logs (see docs/deploying.md)."
}

# --- everyday -------------------------------------------------------------------------------

cmd_up() { compose up -d --wait --wait-timeout 180 "$@"; }
cmd_down() { compose down "$@"; }

# Each service's own health, asked from inside the stack (app's container has Node).
service_health() {
  compose exec -T app node -e '
    const services = { gateway: null, auth: "http://auth:3000", ledger: "http://ledger:8000",
      app: "http://127.0.0.1:3000", ai: "http://ai:3000" };
    (async () => {
      for (const [name, url] of Object.entries(services)) {
        if (!url) continue;
        try {
          const r = await fetch(url + "/health", { signal: AbortSignal.timeout(3000) });
          const h = await r.json();
          console.log(`${name.padEnd(8)} ${r.ok ? "up  " : "down"} version ${h.version}, schema ${h.schema}`);
        } catch { console.log(`${name.padEnd(8)} down`); }
      }
    })();' 2>/dev/null || say "(app isn't running, so the services' health can't be asked)"
}

cmd_status() {
  local pinned newest marker
  local project
  pinned="$(setting LUMINOUS_MONEY_VERSION)"
  project="$(setting COMPOSE_PROJECT_NAME)"
  say "Deployment: $HOME_DIR (project ${project:-$(basename "$HOME_DIR" | tr 'A-Z' 'a-z')})"
  if [ -n "$pinned" ]; then say "Version:    $pinned (pinned in .env)"; else say "Version:    dev (none pinned in .env)"; fi
  newest="$(latest || true)"
  if [ -n "$newest" ]; then
    if [ "$newest" = "$pinned" ]; then say "Latest:     $newest (up to date)"; else say "Latest:     $newest (\`luminous-money upgrade\` to move to it)"; fi
  fi
  marker="$(compose exec -T ledger cat /data/last-backup.json 2>/dev/null || true)"
  say "Backup:     ${marker:-none made with \`luminous-money backup\` yet}"
  say ""
  compose ps --format 'table {{.Service}}\t{{.State}}\t{{.Status}}'
  say ""
  service_health
  if [ -n "$(setting LUMINOUS_MONEY_DOMAIN)" ]; then certificate_health; fi
}

# The gateway's certificate (as app watches it, for /api/health), and what Let's Encrypt
# complained about in the last day: renewals that fail show up here weeks before it expires.
certificate_health() {
  compose exec -T app node -e '
    fetch("http://127.0.0.1:3000/api/health").then((r) => r.json()).then((h) => {
      const c = h.certificate;
      if (!c) return;
      const when = c.expires ? `, expires ${c.expires.slice(0, 10)} (in ${c.days_left} days)` : "";
      console.log(`certificate ${c.status}${when}, for ${c.domain}`);
    }).catch(() => console.log("certificate unknown (app did not answer)"));' 2>/dev/null || true
  local trouble
  trouble="$(compose logs --since 24h --no-color traefik 2>/dev/null | grep -i 'acme' | grep -iE 'ERR|error|unable' | tail -3 || true)"
  if [ -n "$trouble" ]; then
    say ""
    say "Let's Encrypt trouble in the last day (all of it: luminous-money logs traefik --since 24h):"
    say "$trouble"
  fi
}

cmd_logs() {
  local args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --since) args+=(--since "$2"); shift 2 ;;
      -f | --follow) args+=(--follow); shift ;;
      *) args+=("$1"); shift ;;
    esac
  done
  compose logs --timestamps --no-color ${args[@]+"${args[@]}"}
}

# --- backups --------------------------------------------------------------------------------

# shellcheck disable=SC2120 # upgrade calls it without options
cmd_backup() {
  local keep="" dir version file tmp
  while [ $# -gt 0 ]; do
    case "$1" in
      --keep) keep="$2"; shift 2 ;;
      *) die "backup: unknown option $1" ;;
    esac
  done
  dir="$HOME_DIR/backups"
  mkdir -p "$dir"
  version="$(setting LUMINOUS_MONEY_VERSION)"
  file="$dir/luminous-money-$(stamp)-${version:-dev}.tar"
  tmp="$file.partial"
  umask 077
  # A one-off container of the ledger's image on the data volume: every database copied with
  # SQLite's backup API (safe while running), and the attachments.
  compose run --rm -T --no-deps ledger python -m ledger.snapshot backup >"$tmp" ||
    { rm -f "$tmp"; die "the backup failed"; }
  tar -rf "$tmp" -C "$HOME_DIR" .env # its keys open what's stored
  gzip -c "$tmp" >"$file.gz" && rm -f "$tmp"
  umask 022
  say "Backed up: $file.gz"
  if [ -n "$keep" ]; then
    # Oldest first by name (they're named by time); remove all but the newest $keep.
    ls -1 "$dir"/luminous-money-*.tar.gz 2>/dev/null | sort | awk -v keep="$keep" '
      { files[NR] = $0 } END { for (i = 1; i <= NR - keep; i++) print files[i] }' |
      while read -r old; do rm -f "$old" && say "Removed: $old"; done
  fi
}

cmd_restore() {
  local file="" version="" yes=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --version) version="$2"; shift 2 ;;
      --yes) yes=1; shift ;;
      *) file="$1"; shift ;;
    esac
  done
  [ -n "$file" ] && [ -f "$file" ] || die "restore: which backup? (a file in backups/)"
  if [ -z "$yes" ]; then
    [ -t 0 ] || die "restore replaces everything: run it at a terminal, or pass --yes"
    local answer
    read -r -p "Replace everything in $HOME_DIR with $(basename "$file")? Type yes: " answer
    [ "$answer" = yes ] || die "nothing changed"
  fi
  # The keys belong with the data they sealed: take the backup's.
  local saved name
  saved="$(gzip -dc "$file" | tar -xOf - .env 2>/dev/null || true)"
  for name in SIMPLEFIN_ENCRYPTION_KEY AI_ENCRYPTION_KEY; do
    local value
    value="$(printf '%s\n' "$saved" | awk -F= -v key="$name" '$1 == key { sub(/^[^=]*=/, ""); print; exit }')"
    if [ -n "$value" ]; then set_setting "$name" "$value"; fi
  done
  if [ -n "$version" ]; then set_setting LUMINOUS_MONEY_VERSION "$version"; fi
  compose stop
  gzip -dc "$file" | compose run --rm -T --no-deps ledger python -m ledger.snapshot restore ||
    die "the restore failed: the stack is stopped; try again, or restore another backup"
  compose up -d --wait --wait-timeout 180
  say "Restored $(basename "$file")."
}

# --- upgrades -------------------------------------------------------------------------------

cmd_upgrade() {
  local target="" from="" current
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) from="$(cd "$2" && pwd)"; shift 2 ;;
      *) target="$1"; shift ;;
    esac
  done
  current="$(setting LUMINOUS_MONEY_VERSION)"
  if [ -z "$target" ]; then
    [ -z "$from" ] || die "upgrade --from needs the version to run"
    target="$(latest)"
    [ -n "$target" ] || die "couldn't find the latest release: give the version"
  fi
  if [ "$target" = "$current" ] && [ -z "$from" ]; then
    say "Already on $current."
    return
  fi
  say "Upgrading from ${current:-dev} to $target. First, a backup:"
  cmd_backup
  local next="$HOME_DIR/compose.yaml.next"
  fetch compose.yaml "$target" "$from" "$next"
  if [ -z "$from" ]; then
    fetch luminous-money "$target" "" "$HOME_DIR/luminous-money.next" &&
      chmod +x "$HOME_DIR/luminous-money.next" && mv "$HOME_DIR/luminous-money.next" "$HOME_DIR/luminous-money"
  fi
  cp "$HOME_DIR/compose.yaml" "$HOME_DIR/compose.yaml.before-$target"
  mv "$next" "$HOME_DIR/compose.yaml"
  set_setting LUMINOUS_MONEY_VERSION "$target"
  if [ "$(setting LUMINOUS_MONEY_REGISTRY)" != luminous-money ]; then compose pull --quiet; fi
  # Each service migrates its own database as it starts.
  if compose up -d --wait --wait-timeout 300 --remove-orphans; then
    say "Now on $target."
  else
    warn "It didn't come up healthy. \`luminous-money logs --since 10m\` says why. To go back:"
    warn "  cp $HOME_DIR/compose.yaml.before-$target $HOME_DIR/compose.yaml"
    warn "  $HOME_DIR/luminous-money restore $(ls -1 "$HOME_DIR"/backups/luminous-money-*.tar.gz | sort | tail -1) --version ${current:-dev}"
    exit 1
  fi
}

# --- diagnostics ----------------------------------------------------------------------------

# .env with every secret's value hidden.
redacted() {
  awk -F= '
    /^[[:space:]]*#/ || !/=/ { print; next }
    $1 ~ /(KEY|SECRET|TOKEN|PASSWORD|SMTP_URL|CATEGORIZERS)/ {
      print $1 "=" (length($0) > length($1) + 1 ? "(set, hidden)" : ""); next
    }
    { print }
  ' "$HOME_DIR/.env"
}

cmd_config() {
  local problems=0 name value
  for name in SIMPLEFIN_ENCRYPTION_KEY AI_ENCRYPTION_KEY; do
    value="$(setting "$name")"
    if [ -z "$value" ]; then
      warn "$name is missing (\`openssl rand -base64 32\` makes one)"
      problems=1
    elif [ "$(printf '%s' "$value" | base64 -d 2>/dev/null | wc -c | tr -d ' ')" != 32 ] &&
      [ "$(printf '%s' "$value" | base64 -D 2>/dev/null | wc -c | tr -d ' ')" != 32 ]; then
      warn "$name isn't 32 bytes of base64"
      problems=1
    fi
  done
  if [ -n "$(setting LUMINOUS_MONEY_DOMAIN)" ] && [ -z "$(setting LUMINOUS_MONEY_ACME_EMAIL)" ]; then
    warn "LUMINOUS_MONEY_DOMAIN needs LUMINOUS_MONEY_ACME_EMAIL"
    problems=1
  fi
  compose config --quiet || problems=1
  redacted
  if [ "$problems" != 0 ]; then exit 1; fi
  say "(.env looks right)"
}

cmd_report() {
  local since="24h" out tmp
  while [ $# -gt 0 ]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      *) die "report: unknown option $1" ;;
    esac
  done
  tmp="$(mktemp -d)"
  out="$HOME_DIR/luminous-money-report-$(stamp).tar.gz"
  {
    say "luminous-money report, $(date -u)"
    say ""
    cmd_status
  } >"$tmp/status.txt" 2>&1 || true
  compose logs --timestamps --no-color --since "$since" >"$tmp/logs.txt" 2>&1 || true
  redacted >"$tmp/settings.txt"
  compose ps --format json >"$tmp/containers.json" 2>/dev/null || true
  compose images >"$tmp/images.txt" 2>&1 || true
  {
    uname -a
    docker version --format '{{.Server.Version}} (server), {{.Client.Version}} (client)' 2>&1
    docker compose version 2>&1
    df -h "$HOME_DIR" 2>&1
  } >"$tmp/host.txt"
  tar -czf "$out" -C "$tmp" .
  rm -rf "$tmp"
  say "Wrote $out"
  say "It has the last $since of logs: request paths there name book IDs and accounts, but"
  say "never amounts or credentials, and settings.txt has every secret hidden. Look before sharing."
}

# --- main -----------------------------------------------------------------------------------

main() {
  local command="${1:-help}"
  [ $# -gt 0 ] && shift
  case "$command" in
    install) cmd_install "$@" ;;
    help | -h | --help) usage ;;
    status | up | down | upgrade | backup | restore | logs | report | config)
      need
      HOME_DIR="$(deployment)"
      "cmd_$command" "$@"
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
