{
  "name": "@luminous-money/ledger-graphs-ui",
  "version": "0.1.0",
  "description": "React charts for @luminous-money/ledger-graphs-api's datasets, drawn with Apache ECharts: spending against a budget and a simulated month, cash flow, breakdowns, net worth.",
  "license": "ISC",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -Rf ./dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@luminous-money/ledger-graphs-api": "workspace:*"
  },
  "peerDependencies": {
    "echarts": "^6.1.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "echarts": "^6.1.0",
    "react": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
