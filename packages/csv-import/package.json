{
  "name": "@fava-beans/csv-import",
  "version": "0.1.0",
  "description": "Bank CSVs: parsing, guessing a profile (which column is what), and normalizing rows with it.",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -Rf ./dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "papaparse": "^5.7.0"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
