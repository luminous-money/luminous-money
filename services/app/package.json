{
  "name": "@luminous-money/app",
  "version": "0.1.0",
  "license": "GPL-2.0-or-later",
  "private": true,
  "description": "The review app: serves the PWA at /ui and its API at /api/app/v1.",
  "type": "module",
  "files": [
    "dist",
    ".env"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/main.js",
    "clean": "rm -Rf ./dist",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@luminous-money/ai-api": "workspace:*",
    "@luminous-money/csv-import": "workspace:*",
    "@luminous-money/db": "workspace:*",
    "@luminous-money/ledger-client": "workspace:*",
    "@luminous-money/ledger-graphs-api": "^0.1.1",
    "@luminous-money/ledger-graphs-ui": "^0.1.1",
    "@wymp/config-simple": "^1.1.0",
    "dotenv": "^18.0.8",
    "echarts": "^6.1.0",
    "heic-decode": "^2.1.0",
    "hono": "^4.13.13",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@luminous-money/simplefin-fake": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "wouter": "^3.13.0"
  }
}
