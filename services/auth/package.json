{
  "name": "@fava-beans/auth",
  "version": "0.1.0",
  "private": true,
  "description": "Users, sign-up and sessions: short-lived access tokens with rotating refresh, API tokens, and the verify endpoint behind Traefik's forwardAuth.",
  "type": "module",
  "files": [
    "dist",
    ".env"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "clean": "rm -Rf ./dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fava-beans/db": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "@wymp/config-simple": "^1.1.0",
    "dotenv": "^18.0.8",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "nodemailer": "^7.0.11"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
