{
  "name": "@luminous-money/ai",
  "version": "0.1.0",
  "license": "GPL-2.0-or-later",
  "private": true,
  "description": "AI for a book (M16): its settings and provider credential, and reading receipts into proposed transactions.",
  "type": "module",
  "files": [
    "dist",
    ".env"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "clean": "rm -Rf ./dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@luminous-money/ai-api": "workspace:*",
    "@luminous-money/db": "workspace:*",
    "@luminous-money/ledger-client": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "@wymp/config-simple": "^1.1.0",
    "dotenv": "^18.0.8",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
