# Luminous Money's settings: copy this to `.env` beside compose.yaml and fill it in. (`luminous-money
# install` writes one for you.) docs/deploying.md explains each. Keep the file private (chmod
# 600) and back it up: its keys open what's stored.

# --- The release ---------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=luminous-money
LUMINOUS_MONEY_REGISTRY=ghcr.io/luminous-money/luminous-money
# A release's version: nothing changes until you change this (`luminous-money upgrade` does).
LUMINOUS_MONEY_VERSION=0.1.0

# --- Where people reach it --------------------------------------------------------------------
# A laptop, your network, or behind a proxy you have: plain HTTP on one port.
LUMINOUS_MONEY_PORT=8080
# LUMINOUS_MONEY_BIND=127.0.0.1                 # this machine only
#
# A public server: HTTPS for a domain whose DNS points here, with a Let's Encrypt certificate.
# Ports 80 and 443 must reach this machine.
# LUMINOUS_MONEY_DOMAIN=books.example.com
# LUMINOUS_MONEY_ACME_EMAIL=you@example.com
# LUMINOUS_MONEY_PORT=80
# LUMINOUS_MONEY_HTTPS_PORT=443
#
# The address people use (links in emails point here; auth accepts writes from it alone). Set
# it for a public server, or behind a proxy.
# LUMINOUS_MONEY_PUBLIC_URL=https://books.example.com
#
# Behind a proxy that terminates TLS: the addresses whose X-Forwarded-* headers to believe.
# Default: private networks and loopback.
# LUMINOUS_MONEY_TRUSTED_PROXIES=10.0.0.0/8

# --- Secrets: required, 32 random bytes each (`openssl rand -base64 32`) ------------------------
SIMPLEFIN_ENCRYPTION_KEY=
AI_ENCRYPTION_KEY=

# --- Email (optional): password resets and confirming addresses --------------------------------
# Without it, `docker compose exec auth node dist/cli.js reset-link <email>` makes reset links.
# SMTP_URL=smtps://user:password@smtp.example.com
# MAIL_FROM=Luminous Money <books@example.com>

# --- Who may create an account ------------------------------------------------------------------
# public: anyone who can reach it (the default). private: only these emails (comma-separated,
# any case); once they all have accounts, the app says it's a private instance instead of
# offering sign-up. List the admins too, if they're to have accounts.
# LUMINOUS_MONEY_SERVICE_MODE=private
# LUMINOUS_MONEY_ALLOWED_EMAILS=you@example.com,partner@example.com

# --- Admins, and new releases ------------------------------------------------------------------
# The system page's admins, by email (they see it once their email is confirmed).
# LUMINOUS_MONEY_ADMINS=you@example.com
# notify (the system page says when a release is out), off, or auto (`luminous-money
# auto-upgrade on` sets it, with the time it upgrades).
# LUMINOUS_MONEY_UPDATES=notify

# --- Optional -----------------------------------------------------------------------------------
# AUTH_BREACHED_PASSWORDS=true              # check new passwords against Have I Been Pwned
# AUTH_SIGNUPS_PER_HOUR=20                  # sign-ups allowed per address per hour
# SIMPLEFIN_HOSTS=bridge.simplefin.org,beta-bridge.simplefin.org
# LUMINOUS_MONEY_SIMPLEFIN_MODE=daily                   # or on-demand: bank feeds sync only on Sync now
# CATEGORIZERS=[]                           # external categorizers (docs/categorizer-api.md)
# AI_CLAUDE_EXTRACT_MODEL=claude-sonnet-5
# AI_CLAUDE_CATEGORIZE_MODEL=claude-opus-5
